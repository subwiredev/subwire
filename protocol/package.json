{
  "name": "subwire",
  "version": "1.2.0",
  "description": "Shared types and pure helpers for the Subwire protocol: slugs, sw:// URIs, signal shapes, limits, error bodies.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subwiredev/subwire.git",
    "directory": "protocol"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.9.3"
  }
}
