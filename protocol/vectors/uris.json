{
  "$comment": "Conformance vectors for sw:// URIs. A subwire is addressed by its authority alone (one server, one subwire); signals are organized by tags, not address. Parsing follows WHATWG URL semantics for the sw: scheme - notably the host is lowercased. Targets: subwire (the authority), signal (/signals/{id}), identity (/identities/{id}). 'httpsUrl' maps the URI onto the authority's HTTPS surface, where protocol traffic is namespaced under /sw/.",
  "version": "2",
  "cases": [
    {
      "input": "sw://subwire.ai",
      "expect": { "host": "subwire.ai", "port": null, "target": { "kind": "subwire" } },
      "httpsUrl": "https://subwire.ai/sw"
    },
    {
      "input": "sw://SUBWIRE.AI",
      "expect": { "host": "subwire.ai", "port": null, "target": { "kind": "subwire" } },
      "httpsUrl": "https://subwire.ai/sw"
    },
    {
      "input": "sw://localhost:8088",
      "expect": { "host": "localhost", "port": "8088", "target": { "kind": "subwire" } },
      "httpsUrl": "https://localhost:8088/sw"
    },
    {
      "input": "sw://thirdparty.com/",
      "expect": { "host": "thirdparty.com", "port": null, "target": { "kind": "subwire" } },
      "httpsUrl": "https://thirdparty.com/sw"
    },
    {
      "input": "sw://subwire.ai/signals/j1YkHQ5IOrHBtsxdrRqq",
      "expect": {
        "host": "subwire.ai",
        "port": null,
        "target": { "kind": "signal", "signalId": "j1YkHQ5IOrHBtsxdrRqq" }
      },
      "httpsUrl": "https://subwire.ai/sw/signals/j1YkHQ5IOrHBtsxdrRqq"
    },
    {
      "input": "sw://subwire.ai/identities/xt0n8TrX",
      "expect": { "host": "subwire.ai", "port": null, "target": { "kind": "identity", "identity": "xt0n8TrX" } },
      "httpsUrl": "https://subwire.ai/identities/xt0n8TrX"
    }
  ],
  "errors": [
    "https://subwire.ai/signals/x",
    "sw://subwire.ai/news",
    "sw://subwire.ai/identities",
    "sw://subwire.ai/signals",
    "sw://subwire.ai/signals/id/extra",
    "sw://subwire.ai/news/signals/x"
  ]
}
